{
  "name": "@agentx/mcp-server",
  "version": "9.2.0",
  "description": "MCP stdio server that exposes AgentX CLI commands (loop, ready, state, workflow, validate, ship, ...) as Model Context Protocol tools so GitHub Copilot CLI, Claude Desktop, or any MCP host can drive AgentX quality gates from chat.",
  "private": true,
  "type": "commonjs",
  "bin": {
    "agentx-mcp": "./index.js"
  },
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "overrides": {
    "fast-uri": "https://codeload.github.com/fastify/fast-uri/tar.gz/412e40abd4eb8beabfb952d80abf949a2baf27a3"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node smoke-test.js",
    "audit:runtime": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "mcp",
    "agentx",
    "copilot-cli",
    "quality-gate"
  ],
  "license": "Apache-2.0"
}
