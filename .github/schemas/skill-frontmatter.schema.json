{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "AgentX Skill File Frontmatter",
 "description": "Schema for SKILL.md frontmatter validation",
 "type": "object",
 "required": ["name", "description"],
 "properties": {
 "name": {
 "type": "string",
 "minLength": 2,
 "maxLength": 100,
 "pattern": "^[a-z][a-z0-9-]*$",
 "description": "Skill name in kebab-case"
 },
 "description": {
 "type": "string",
 "minLength": 50,
 "maxLength": 1024,
 "description": "WHAT + WHEN + KEYWORDS format description"
 },
 "argument-hint": {
 "type": "string",
 "description": "Optional input hint shown for user-invocable skills"
 },
 "user-invocable": {
 "type": "boolean",
 "description": "Whether the skill appears in the slash-command menu"
 },
 "disable-model-invocation": {
 "type": "boolean",
 "description": "Whether automatic model activation is disabled"
 },
 "context": {
 "type": "string",
 "enum": ["inline", "fork"],
 "description": "Whether skill instructions load inline or execute in a forked context"
 },
 "metadata": {
 "type": "object",
 "properties": {
 "author": { "type": "string" },
 "version": {
 "type": "string",
 "pattern": "^\\d+\\.\\d+\\.\\d+$"
 },
 "created": { "type": "string" },
 "updated": { "type": "string" }
 },
 "description": "Skill metadata"
 },
 "compatibility": {
 "type": "object",
 "description": "Compatibility markers (languages, frameworks, platforms)"
 }
 },
 "additionalProperties": true
}
