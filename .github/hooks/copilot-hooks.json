{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "powershell": "node .github/hooks/scripts/signal-capture.js sessionStart",
        "bash": "node .github/hooks/scripts/signal-capture.js sessionStart",
        "type": "command",
        "timeoutSec": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "powershell": "node .github/hooks/scripts/signal-capture.js UserPromptSubmit",
        "bash": "node .github/hooks/scripts/signal-capture.js UserPromptSubmit",
        "type": "command",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "powershell": "node .github/hooks/scripts/signal-capture.js preToolUse",
        "bash": "node .github/hooks/scripts/signal-capture.js preToolUse",
        "type": "command",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "powershell": "node .github/hooks/scripts/signal-capture.js postToolUse",
        "bash": "node .github/hooks/scripts/signal-capture.js postToolUse",
        "type": "command",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "powershell": "node .github/hooks/scripts/signal-capture.js agentStop",
        "bash": "node .github/hooks/scripts/signal-capture.js agentStop",
        "type": "command",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "powershell": "node .github/hooks/scripts/signal-capture.js sessionEnd",
        "bash": "node .github/hooks/scripts/signal-capture.js sessionEnd",
        "type": "command",
        "timeoutSec": 10
      }
    ],
    "errorOccurred": [
      {
        "powershell": "node .github/hooks/scripts/signal-capture.js errorOccurred",
        "bash": "node .github/hooks/scripts/signal-capture.js errorOccurred",
        "type": "command",
        "timeoutSec": 10
      }
    ]
  }
}
