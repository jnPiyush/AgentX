#!/usr/bin/env bash
if ! command -v timeout >/dev/null 2>&1; then
 echo "[WARN] timeout is required for bounded Git checks." >&2
 exit 1
fi
LOOP_REPO_ROOT=$(GIT_TERMINAL_PROMPT=0 timeout 10s git rev-parse --show-toplevel 2>/dev/null) || exit 1
[ -f "$LOOP_REPO_ROOT/.frontier/state/loop-commit-acceptance.json" ] || exit 0
if ! command -v pwsh >/dev/null 2>&1; then
 echo "[WARN] PowerShell is required to consume the accepted covered loop evidence." >&2
 exit 1
fi
FRONTIER_WORKSPACE_ROOT="$LOOP_REPO_ROOT" pwsh -NoProfile -File "$LOOP_REPO_ROOT/.frontier/runtime/frontier.ps1" loop consume