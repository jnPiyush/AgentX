{
  "name": "agentx-whatsapp-companion",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp companion that controls Frontier running on your desktop via the local CLI.",
  "main": "src/bot.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/bot.js",
    "start:debug": "cross-env DEBUG=agentx:* node src/bot.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node scripts/check-coverage.js",
    "audit:runtime": "npm audit --omit=dev --omit=optional --audit-level=high"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "cross-env": "7.0.3"
  },
  "overrides": {
    "puppeteer": "25.10.0",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "ip-address": "10.4.0",
    "js-yaml": "5.2.2"
  }
}
