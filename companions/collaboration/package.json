{
  "name": "frontier-collaboration-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated Teams and GitHub App progress and instructions for the local Frontier runtime.",
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=src/*.js --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test test/*.test.js",
    "audit:runtime": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@microsoft/agents-hosting": "1.8.1",
    "@octokit/app": "16.1.4",
    "@octokit/webhooks": "14.2.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "proper-lockfile": "4.1.2"
  }
}
