FRONTIER_CHANNELS=teams,github
FRONTIER_WORKSPACE_ROOT=C:/path/to/workspace
FRONTIER_CLI_PATH=.frontier/runtime/frontier.ps1
FRONTIER_REMOTE_EXECUTION=false
FRONTIER_REMOTE_AGENTS=engineer,reviewer
FRONTIER_BIND_HOST=127.0.0.1
PORT=3978
FRONTIER_PROGRESS_MS=30000
FRONTIER_RUN_TIMEOUT_MS=900000
# Optional comma-separated supported LLM variable names, never secret values.
# Example: FRONTIER_RUNTIME_ENV=FRONTIER_LLM_PROVIDER,OPENAI_API_KEY
FRONTIER_RUNTIME_ENV=

FRONTIER_GITHUB_APP_ID=
FRONTIER_GITHUB_INSTALLATION_ID=
FRONTIER_GITHUB_REPOSITORY=owner/repository
FRONTIER_GITHUB_USERS=
FRONTIER_GITHUB_PRIVATE_KEY_FILE=C:/private/frontier-app.pem
FRONTIER_GITHUB_WEBHOOK_SECRET=

FRONTIER_TEAMS_APP_ID=
FRONTIER_TEAMS_TENANT_ID=
FRONTIER_TEAMS_APP_SECRET=
FRONTIER_TEAMS_USERS=
FRONTIER_TEAMS_CONVERSATIONS=