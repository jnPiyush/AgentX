  "capabilities": {
    "agentOrchestration": "Copilot CLI agent definitions with handoffs and body instructions",
    "skillLibrary": "134 production code skills across 14 categories",
    "instructionFiles": "15 auto-applied instruction files for language-specific and domain patterns",
    "promptTemplates": "23 reference prompt templates (Copilot CLI does not execute prompt files)",
    "cliUtilities": "Workspace wrapper scripts plus a bundled hidden runtime for issue tracking, loop management, and workflow",
    "iterativeLoop": "Quality loop enforcement via CLI hard gate (Layer 3)",
    "nativePlugin": "Installable as a native Copilot CLI plugin via the repository-root plugin.json",
    "hooks": "Copilot CLI lifecycle hooks for signal capture and workflow enforcement"
  },
  "limitations": {
    "noSidebar": "No VS Code sidebar views -- use CLI commands directly",
    "layerCoverage": "Quality enforcement: Layer 2 (body instructions) + Layer 3 (CLI gate) + lifecycle hooks",
    "noPromptExecution": "Copilot CLI does not execute prompt files -- prompts install as reference templates; use agents or skills for executable behaviour"
  },
  "install": {
    "powershell": "pwsh packs/agentx-copilot-cli/install.ps1",
    "bash": "bash packs/agentx-copilot-cli/install.sh",
    "note": "Installer copies agents, skills, instructions, prompts, and optional wrapper-backed CLI runtime assets into the target workspace.",
    "plugin": "copilot plugin install jnPiyush/AgentX"
  },
