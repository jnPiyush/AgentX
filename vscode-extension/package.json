    "configurationDefaults": {
      "chat.useCustomAgentHooks": true
    },
    "configuration": {
      "title": "Frontier",
      "properties": {
        "frontier.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh agent status."
        },
        "frontier.shell": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "pwsh",
            "bash"
          ],
          "description": "Shell to use for Frontier CLI commands."
        },
        "frontier.rootPath": {
          "type": "string",
          "default": "",
          "description": "Explicit path to the Frontier project root (folder containing AGENTS.md and .agentx/). Leave empty for auto-detection. Useful when Frontier is initialized in a subfolder or non-first workspace folder."
        },
        "frontier.searchDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "How many subfolder levels to search when auto-detecting the Frontier root. Set to 0 to only check workspace folder roots."
        },
        "frontier.skipStartupCheck": {
          "type": "boolean",
          "default": false,
          "description": "Skip the automatic environment health check on extension activation. You can always run it manually via Frontier: Check Environment."
        },
        "frontier.skipUpdateCheck": {
          "type": "boolean",
          "default": false,
          "description": "Skip the automatic version check that detects outdated framework files on extension activation. When enabled, you will not be prompted to update."
        },
        "frontier.companionDismissed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of companion extension IDs for which the install prompt has been permanently dismissed."
        },
        "frontier.seedRepoLocalAssets": {
          "type": "boolean",
          "default": false,
          "description": "When Initialize Local Runtime runs, also copy bundled agents, skills, instructions, prompts, templates, and schemas into the workspace .github/ folder. Required only for non-VS-Code surfaces (e.g. GitHub Copilot CLI) that need repo-local discovery. VS Code chat, commands, and the Frontier runtime resolve these assets from the extension bundle and do not need this seed. Default: false (zero-copy)."
        },
        "frontier.cliAssetMode": {
          "type": "string",
          "enum": [
            "copy",
            "symlink"
          ],
          "default": "copy",
          "description": "Default mode used by 'Frontier: Initialize CLI'. 'copy' duplicates bundled assets into .github/ (team-friendly, committable). 'symlink' creates directory junctions/symlinks pointing at the installed extension bundle (zero-copy, single-user; .gitignore'd; auto-refreshed when the bundle moves on extension upgrade)."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "sync:version": "node ../scripts/stamp-version.js",
    "copy:assets": "node scripts/copy-assets.js",
    "prepare:chat": "node scripts/prepare-chat-contributions.js",
    "vscode:prepublish": "npm run sync:version && npm run prepare:chat && npm run clean && tsc -p ./",
    "compile": "npm run sync:version && npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && mocha",
    "test:coverage": "npm run compile && c8 --all --src out --include \"out/**/*.js\" --exclude \"out/test/**\" --exclude \"out/e2e/**\" --exclude \"out/**/mocks/**\" --exclude \"out/extension.js\" --exclude \"out/**/*Types.js\" --exclude \"out/**/types.js\" --reporter=text --reporter=html --reporter=lcov --check-coverage --lines 80 --statements 80 --functions 80 --branches 73 mocha \"out/test/**/*.js\"",
    "test:e2e": "npm run compile && node scripts/run-e2e.js",
    "coverage:html": "npm run test:coverage",
    "coverage:lcov": "npm run test:coverage",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.137.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.0.0",
    "c8": "^10.1.3",
    "eslint": "^8.56.0",
    "mocha": "^11.3.0",
    "sinon": "^21.0.1",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "^7.0.3",
    "undici": "7.29.0",
    "flatted": "3.4.2"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  }
}
